# VCS
.git/
.gitignore
.gitkeep
.gitlab/
.gitlab-ci.yml
.gitleaks.toml

# Local secrets / environment
.env
.env.*
config/.env
config/.env.*
!config/.env.dist

# Runtime inputs mounted by compose, not baked into the image
artifacts/

# Python build / cache
__pycache__/
*.py[cod]
*$py.class
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# Tests / docs / wiki (not needed at runtime)
tests/
docs/
wiki/

# Template-internal / dev tooling
scripts/
# except the two build-time scripts the distroless build runs: `stage_libs.py`
# (the `lib-staging` stage runs it to copy missing system .so files in) and
# `validate_imports.py` (bind-mounted import gate that fails the `hardened`
# build if any extension module cannot be dynamically linked).
!scripts/stage_libs.py
!scripts/validate_imports.py
Makefile
.pre-commit-config.yaml
trivy.yaml
AGENTS.md
CLAUDE.md

# Docker, image build files live in docker/. The Dockerfile is read via `-f`
# (not from the context) and the README never ships; only extra-libs.txt must
# reach the build context, where the lib-staging stage COPYs it.
.dockerignore
docker-compose.yaml
docker-compose.*.yaml
docker/
!docker/extra-libs.txt

# IDE / OS
.vscode/
.idea/
.cursor/
*.swp
.DS_Store
