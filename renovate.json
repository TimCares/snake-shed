{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enableVulnerabilityAlertsWithLabel(security)",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "update-lockfile",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 * * 1"]
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "gitlabci": {
    "fileMatch": ["^\\.gitlab/ci/.*\\.ya?ml$"]
  },
  "packageRules": [
    {
      "description": "Major bumps land alone and need manual review",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"],
      "automerge": false
    },
    {
      "description": "Container images get digest pinning by default",
      "matchManagers": ["dockerfile", "docker-compose", "gitlabci"],
      "groupName": "container images",
      "pinDigests": true
    },
    {
      "description": "Python runtime minor/major upgrades require explicit dashboard approval",
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "python runtime",
      "groupSlug": "python-runtime",
      "addLabels": ["runtime", "manual-review"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "uv toolchain version upgrades require explicit dashboard approval",
      "matchPackageNames": ["uv-build", "ghcr.io/astral-sh/uv"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "groupName": "uv toolchain",
      "groupSlug": "uv-toolchain",
      "addLabels": ["toolchain", "manual-review"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group all Python dev dependencies into one PR",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dev"],
      "groupName": "python dev dependencies"
    },
    {
      "description": "All pre-commit hook revs land in one PR by default",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Pytest + plugins together (overrides earlier dev/precommit grouping)",
      "matchPackageNames": ["/^pytest/"],
      "groupName": "pytest"
    },
    {
      "description": "Ruff library + pre-commit hook together (overrides earlier grouping)",
      "matchPackageNames": ["/^ruff$/", "/ruff-pre-commit/"],
      "groupName": "ruff"
    },
    {
      "description": "Gitleaks Docker image + pre-commit hook in lockstep (overrides earlier grouping)",
      "matchPackageNames": ["/gitleaks\\/gitleaks/", "/zricethezav\\/gitleaks/"],
      "groupName": "gitleaks"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": "at any time",
    "minimumReleaseAge": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track inline-pinned tool versions in CI YAML via `# renovate: datasource=... depName=...` annotations.",
      "fileMatch": ["^\\.gitlab/ci/.*\\.ya?ml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[a-z-]+))?\\s+[A-Z_]+:\\s*\"(?<currentValue>v?[\\d][^\"]*)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
